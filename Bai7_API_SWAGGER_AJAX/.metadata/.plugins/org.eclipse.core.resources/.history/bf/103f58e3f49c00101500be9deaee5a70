<!DOCTYPE html>
<html lang="vi" xmlns:th="http://www.thymeleaf.org"
      xmlns:layout="http://www.ultraq.net.nz/thymeleaf/layout">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" 
          rel="stylesheet" xintegrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" 
          crossorigin="anonymous">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    
    <title layout:title-default="Little Lotus Shop - Admin"></title>

    <!-- CUSTOM AESTHETIC COASTAL NEUTRAL STYLE -->
    <style>
        /* Bảng màu Coastal Neutral đã thống nhất: 
           #C4DADE (Primary), #B9D9D5 (Accent), #F9F0E7 (Background), #ECF2F5 (Card) */
        :root {
            --color-primary: #C4DADE; 
            --color-accent: #B9D9D5; 
            --color-background-main: #F9F0E7; 
            --color-background-card: #ECF2F5; 
            --color-text: #4A5568; 
            --color-text-header: #2D3748; 
            --border-radius: 1rem; 
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--color-background-main);
            color: var(--color-text);
        }

        /* Tùy chỉnh Header Admin */
        .header-admin {
            background-color: white; 
            box-shadow: 0 5px 15px -5px rgba(0, 0, 0, 0.05);
            border-bottom: 1px solid var(--color-background-card) !important;
        }
        .header-admin .fs-4 {
             color: var(--color-text-header);
        }

        /* Logo Custom Style */
        .logo-title {
            line-height: 1;
        }
        .logo-subtitle {
            font-size: 0.75rem; /* Chữ nhỏ hơn */
            font-weight: 400;
            color: var(--color-accent); /* Màu đồng bộ */
            margin-top: -3px;
            display: block;
        }

        /* Nút chung */
        .btn {
            border-radius: 0.5rem; 
            font-weight: 500;
            transition: all 0.3s ease;
        }

        /* Nút Shop (Nhấn mạnh - Primary) */
        .btn-primary {
            background-color: var(--color-accent);
            border-color: var(--color-accent);
            color: white;
        }

        .btn-primary:hover {
            background-color: var(--color-text);
            border-color: var(--color-text);
            color: white;
        }
        
        /* Nút Admin (Nút phụ - Secondary) */
        .btn-outline-secondary {
            color: var(--color-text);
            border-color: var(--color-primary);
            background-color: white;
        }
        
        .btn-outline-secondary:hover {
            background-color: var(--color-primary);
            color: var(--color-text-header);
            border-color: var(--color-primary);
        }
        
        /* Bảng biểu (Clean, Bo góc) */
        .table {
            border-radius: var(--border-radius);
            overflow: hidden; 
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
            background-color: white;
        }
        .table-light, .table thead th {
            background-color: var(--color-background-card) !important;
            color: var(--color-text-header);
            font-weight: 600;
        }
        .table-striped > tbody > tr:nth-of-type(odd) {
             background-color: var(--color-background-card);
        }
        
        /* Thẻ Alert/Message */
        .alert-success {
            background-color: #E0F2F7; 
            color: #155724; 
            border-color: #A9D18E;
            border-radius: var(--border-radius);
        }

        /* Hình ảnh Avatar */
        .rounded-circle {
            border: 3px solid var(--color-primary);
        }
        
    </style>
</head>
<body>
    
    <!-- ADMIN HEADER/NAVBAR -->
    <header class="p-3 mb-4 header-admin">
        <div class="container">
            <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start">
                
                <!-- LOGO MỚI: Little Lotus (Fashion Shop) -->
                <a th:href="@{/}" class="d-flex align-items-start mb-2 mb-lg-0 text-dark text-decoration-none me-4">
                    <i class="fas fa-hand-holding-heart me-2 mt-1" style="font-size: 1.5rem; color: var(--color-accent);"></i>
                    <div class="logo-title">
                        <span class="fs-4 fw-bold">Little Lotus</span>
                        <small class="logo-subtitle">(Fashion Shop)</small>
                    </div>
                </a>
                
                <nav class="nav col-12 col-lg-auto me-lg-auto mb-2 justify-content-center mb-md-0">
                    <!-- Link Shop (Nút chính) -->
                    <a th:href="@{/shop}" class="btn btn-primary me-3">
                        <i class="fas fa-store"></i> Trang Shop
                    </a>
                    
                    <!-- Link Quản lý Danh mục (Đồng bộ Secondary Button) -->
                    <a th:href="@{/admin/categories}" class="btn btn-outline-secondary me-2">
                        <i class="fas fa-tags"></i> Quản lý Danh mục
                    </a>
                    
                    <!-- Link Quản lý Sản phẩm (Đồng bộ Secondary Button) -->
                    <a th:href="@{/admin/products}" class="btn btn-outline-secondary">
                        <i class="fas fa-box-open"></i> Quản lý Sản phẩm
                    </a>
                </nav>
                
                <!-- Hình ảnh sinh viên -->
                <div class="dropdown text-end ms-auto">
                    <img th:src="@{/images/avatar.jpg}" alt="Sinh viên" width="40" height="40" class="rounded-circle shadow-sm"> 
                </div>
                
            </div>
        </div>
    </header>

    <!-- MAIN CONTENT AREA -->
    <main class="container">
        <!-- Đảm bảo nội dung được bo tròn một cách thẩm mỹ -->
        <div class="bg-white p-4 shadow-sm" style="border-radius: var(--border-radius);" layout:fragment="content">
            <!-- Nội dung cụ thể của từng trang sẽ được đặt ở đây -->
        </div>
    </main>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" 
            xintegrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" 
            crossorigin="anonymous"></script>
</body>
</html>
