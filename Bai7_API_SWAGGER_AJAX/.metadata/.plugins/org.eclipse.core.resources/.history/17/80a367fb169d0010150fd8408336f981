<!DOCTYPE html>
<html lang="vi" xmlns:th="http://www.thymeleaf.org"
      xmlns:layout="http://www.ultraq.net.nz/thymeleaf/layout"
      layout:decorate="~{layouts/layout}">
<head>
    <title>Quản lý Danh mục (AJAX)</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>

<div layout:fragment="content">
    
    <h2 class="mb-4">Quản lý Danh mục Sản phẩm (AJAX CRUD)</h2>
    
    <div id="alertMessage" class="alert d-none" role="alert"></div>

    <div class="d-flex justify-content-between mb-3">
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#categoryModal" id="addCategoryBtn">
            <i class="fas fa-plus me-1"></i> Thêm Danh mục Mới
        </button>
    </div>

    <table class="table table-hover table-bordered shadow-sm">
        <thead class="table-dark">
            <tr>
                <th scope="col">ID</th>
                <th scope="col">Tên Danh mục</th>
                <th scope="col">Mô tả</th>
                <th scope="col">Thao tác</th>
            </tr>
        </thead>
        <tbody id="categoryTableBody">
            <tr><td colspan="4" class="text-center">Đang tải dữ liệu...</td></tr>
        </tbody>
    </table>

    <div class="modal fade" id="categoryModal" tabindex="-1" aria-labelledby="categoryModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="categoryForm">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title" id="categoryModalLabel"></h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="categoryId" name="id">
                        
                        <div class="mb-3">
                            <label for="categoryName" class="form-label">Tên Danh mục (<span class="text-danger">*</span>)</label>
                            <input type="text" class="form-control" id="categoryName" name="name" required maxlength="100">
                            <div class="invalid-feedback" id="nameFeedback">Tên danh mục không được trống và phải hợp lệ.</div>
                        </div>

                        <div class="mb-3">
                            <label for="categoryDescription" class="form-label">Mô tả</label>
                            <textarea class="form-control" id="categoryDescription" name="description"></textarea>
                        </div>
                        
                        <div class="mb-3">
                            <label for="categoryIcon" class="form-label">Ảnh/Icon (Chỉ chấp nhận PNG, JPG)</label>
                            <input type="file" class="form-control" id="categoryIcon" name="icon" accept=".png, .jpg, .jpeg">
                            <div class="invalid-feedback" id="fileFeedback">File không hợp lệ. Chỉ chấp nhận định dạng .png, .jpg, .jpeg.</div>
                        </div>

                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-primary" id="saveCategoryBtn">Lưu</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="deleteConfirmModalLabel">Xác nhận Xóa</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Bạn có chắc chắn muốn xóa danh mục <strong id="deleteCategoryName"></strong> này?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Xóa</button>
                </div>
            </div>
        </div>
    </div>

    <script th:inline="javascript">
        /*<![CDATA[*/
        const API_URL = '/api/v1/categories';
        
        // Ghi Log cho Admin và hiển thị thông báo trên giao diện
        function showMessage(message, type = 'success') {
            const $alert = $('#alertMessage');
            $alert.removeClass('d-none alert-success alert-danger');
            $alert.addClass(`alert-${type}`);
            $alert.text(message);
            
            setTimeout(() => {
                $alert.addClass('d-none');
            }, 5000);
            
            console.log(`[Admin Log] ${type.toUpperCase()}: ${message}`); // Ghi log chi tiết
        }
        
        // --- 1. RENDER DỮ LIỆU ---
        function renderCategoryTable(categories) {
            const $tbody = $('#categoryTableBody');
            $tbody.empty();
            
            if (!Array.isArray(categories) || categories.length === 0) {
                $tbody.append('<tr><td colspan="4" class="text-center">Không có danh mục nào.</td></tr>');
                return;
            }

            categories.forEach(category => {
                const descriptionText = category.description ? category.description : 'N/A';
                
                const row = `
                    <tr id="row-${category.id}">
                        <th scope="row">${category.id}</th>
                        <td>${category.name}</td>
                        <td>${descriptionText}</td>
                        <td>
                            <button class="btn btn-sm btn-info edit-btn me-2" data-id="${category.id}" data-name="${category.name}">
                                <i class="fas fa-edit"></i> Sửa
                            </button>
                            <button class="btn btn-sm btn-danger delete-btn" data-id="${category.id}" data-name="${category.name}">
                                <i class="fas fa-trash"></i> Xóa
                            </button>
                        </td>
                    </tr>
                `;
                $tbody.append(row);
            });
            console.log(`[Admin Log] Đã tải và render ${categories.length} danh mục.`);
        }
        
        // --- 2. TẢI DỮ LIỆU BAN ĐẦU (READ ALL) ---
        function loadCategories() {
            $.ajax({
                url: API_URL,
                type: 'GET',
                dataType: 'json',
                success: function(data) {
                    if (data && Array.isArray(data)) {
                        renderCategoryTable(data);
                    } else {
                        $('#categoryTableBody').html('<tr><td colspan="4" class="text-center text-danger">Dữ liệu nhận được không hợp lệ.</td></tr>');
                        console.error("[Admin Log] API trả về dữ liệu không phải là mảng:", data);
                    }
                },
                error: function(xhr) {
                    const errorMsg = xhr.responseJSON ? (xhr.responseJSON.message || xhr.statusText) : xhr.statusText;
                    $('#categoryTableBody').html(`<tr><td colspan="4" class="text-center text-danger">Lỗi tải dữ liệu: ${errorMsg} (Mã: ${xhr.status})</td></tr>`);
                    console.error("[Admin Log] Lỗi AJAX khi tải danh mục:", xhr);
                }
            });
        }
        
        // --- 3. VALIDATION CỦA FORM (Bao gồm Validate Tên và Định dạng File) ---
        function validateForm() {
            let isValid = true;
            
            // 3a. Validate Tên Danh mục (Không trống và không ký tự đặc biệt)
            const $nameInput = $('#categoryName');
            const nameValue = $nameInput.val().trim();
            // Regex cho phép chữ cái, số, khoảng trắng, và chữ tiếng Việt có dấu
            const nameRegex = /^[a-zA-Z0-9\sáàảãạăắằẳẵặâấầẩẫậèéẻẽẹêếềểễệđíìỉĩịóòỏõọôốồổỗộơớờởỡợúùủũụưứừửữựýỳỷỹỵ]+$/;
            
            if (nameValue === "") {
                $nameInput.addClass('is-invalid');
                $('#nameFeedback').text('Tên danh mục không được để trống.');
                isValid = false;
            } else if (!nameRegex.test(nameValue)) {
                $nameInput.addClass('is-invalid');
                $('#nameFeedback').text('Tên danh mục không được chứa ký tự đặc biệt.');
                isValid = false;
            } else {
                $nameInput.removeClass('is-invalid').addClass('is-valid');
            }
            
            // 3b. Validate File (Chỉ kiểm tra nếu có chọn file)
            const $fileInput = $('#categoryIcon');
            const file = $fileInput[0].files[0];
            if (file) {
                const allowedTypes = ['image/png', 'image/jpeg', 'image/jpg'];
                if (!allowedTypes.includes(file.type)) {
                    $fileInput.addClass('is-invalid');
                    isValid = false;
                } else {
                    $fileInput.removeClass('is-invalid').addClass('is-valid');
                }
            } else {
                $fileInput.removeClass('is-invalid is-valid'); 
            }
            
            return isValid;
        }

        // Hàm reset form và feedback
        function resetFormAndFeedback() {
            $('#categoryForm')[0].reset(); 
            $('.form-control').removeClass('is-invalid is-valid');
            $('#categoryId').val(''); 
            $('#categoryIcon').val('');
        }
        
        // --- 4. XỬ LÝ FORM THÊM/SỬA (CREATE/UPDATE) ---
        $('#categoryForm').submit(function(e) {
            e.preventDefault();
            
            if (!validateForm()) {
                showMessage('Vui lòng kiểm tra lại dữ liệu nhập.', 'danger');
                return;
            }

            const categoryId = $('#categoryId').val();
            const isUpdate = !!categoryId;
            const url = isUpdate ? API_URL + '/' + categoryId : API_URL;
            const method = isUpdate ? 'PUT' : 'POST';
            
            const categoryData = {
                id: isUpdate ? parseInt(categoryId) : null,
                name: $('#categoryName').val(),
                description: $('#categoryDescription').val()
            };
            
            $.ajax({
                url: url,
                type: method,
                contentType: 'application/json',
                data: JSON.stringify(categoryData),
                success: function(data) {
                    $('#categoryModal').modal('hide');
                    loadCategories(); 
                    const msg = isUpdate ? `Cập nhật danh mục ID ${categoryId} thành công!` : `Thêm mới danh mục ID ${data.id || 'mới'} thành công!`;
                    showMessage(msg, 'success');
                },
                error: function(xhr) {
                    const errorMsg = xhr.responseJSON ? (xhr.responseJSON.message || xhr.statusText) : xhr.statusText;
                    showMessage(`Thao tác thất bại: ${errorMsg} (Mã: ${xhr.status})`, 'danger');
                }
            });
        });

        // --- 5. MỞ MODAL THÊM/SỬA VÀ TẢI DỮ LIỆU (Tối ưu hóa code lặp) ---
        $('#addCategoryBtn').click(function() {
            resetFormAndFeedback();
            $('#categoryModalLabel').text('Thêm Danh mục Mới');
            $('#categoryModal').modal('show');
        });

        // Sử dụng event delegation cho nút Sửa
        $(document).on('click', '.edit-btn', function() {
            const id = $(this).data('id');
            
            $.ajax({
                url: API_URL + '/' + id,
                type: 'GET',
                dataType: 'json',
                success: function(category) {
                    resetFormAndFeedback(); 
                    $('#categoryModalLabel').text('Cập nhật Danh mục ID: ' + id);
                    $('#categoryId').val(category.id);
                    $('#categoryName').val(category.name);
                    $('#categoryDescription').val(category.description);
                    $('#categoryModal').modal('show');
                    console.log(`[Admin Log] Đã tải dữ liệu danh mục ID ${id} để chỉnh sửa.`);
                },
                error: function() {
                    showMessage('Không thể tải dữ liệu danh mục để chỉnh sửa.', 'danger');
                }
            });
        });
        
        // --- 6. XỬ LÝ XÓA (DELETE) ---
        let categoryIdToDelete = null;

        $(document).on('click', '.delete-btn', function() {
            categoryIdToDelete = $(this).data('id');
            const categoryName = $(this).data('name');
            $('#deleteCategoryName').text(categoryName);
            $('#deleteConfirmModal').modal('show');
        });

        $('#confirmDeleteBtn').click(function() {
            if (categoryIdToDelete) {
                $.ajax({
                    url: API_URL + '/' + categoryIdToDelete,
                    type: 'DELETE',
                    success: function() {
                        $('#deleteConfirmModal').modal('hide');
                        $(`#row-${categoryIdToDelete}`).fadeOut(500, function() {
                            $(this).remove();
                            loadCategories(); 
                        });
                        showMessage(`Xóa danh mục ID ${categoryIdToDelete} thành công!`, 'success');
                        categoryIdToDelete = null;
                    },
                    error: function(xhr) {
                        $('#deleteConfirmModal').modal('hide');
                        const errorMsg = xhr.responseJSON ? (xhr.responseJSON.message || xhr.statusText) : 'Lỗi server';
                        showMessage(`Xóa thất bại! ${errorMsg}`, 'danger');
                    }
                });
            }
        });

        // --- 7. TẢI DỮ LIỆU KHI TRANG ĐƯỢC LOAD ---
        $(document).ready(function() {
            loadCategories();
        });
        /*]]>*/
    </script>
</div>
</body>
</html>