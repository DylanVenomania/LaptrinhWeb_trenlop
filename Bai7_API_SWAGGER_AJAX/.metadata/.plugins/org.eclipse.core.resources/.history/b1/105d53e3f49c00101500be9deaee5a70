<!DOCTYPE html>
<html lang="vi" xmlns:th="http://www.thymeleaf.org"
      xmlns:layout="http://www.ultraq.net.nz/thymeleaf/layout"
      layout:decorate="~{layouts/layout}">
<head>
    <title>Quản lý Danh mục</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
</head>
<body>
    <div layout:fragment="content">
        <h2 class="mb-4">Quản lý Danh mục Sản phẩm (CRUD & Phân trang)</h2>

        <!-- hiển thị tin  -->
        <div th:if="${message}" class="alert alert-success" role="alert" th:text="${message}"></div>
        <div th:if="${error}" class="alert alert-danger" role="alert" th:text="${error}"></div>
        
        <!-- form tìm kiếm -->
        <div class="d-flex justify-content-between mb-3">
            <a th:href="@{/admin/category/new}" class="btn btn-primary">Thêm Danh mục Mới</a>
            
            <form th:action="@{/admin/categories}" method="get" class="d-flex">
                <input type="text" name="keyword" th:value="${keyword}" class="form-control me-2" placeholder="Tìm kiếm theo Tên..." required>
                <input type="hidden" name="pageSize" th:value="${pageSize}">
                <button type="submit" class="btn btn-outline-secondary">Tìm kiếm</button>
                <a th:href="@{/admin/categories(pageSize=${pageSize})}" class="btn btn-outline-danger ms-2">Xóa Filter</a>
            </form>
        </div>

        <!-- Bảng category -->
        <table class="table table-bordered table-striped">
            <thead class="table-light">
                <tr>
                    <th>
                        <a th:href="@{/admin/categories(pageNo=${currentPage}, pageSize=${pageSize}, sortField='id', sortDir=${reverseSortDir}, keyword=${keyword})}"
                           style="text-decoration: none; color: inherit;">
                            ID
                            <i th:if="${sortField == 'id'}" th:class="${sortDir == 'asc' ? 'fas fa-sort-up' : 'fas fa-sort-down'}"></i>
                        </a>
                    </th>
                    <th>
                        <a th:href="@{/admin/categories(pageNo=${currentPage}, pageSize=${pageSize}, sortField='name', sortDir=${reverseSortDir}, keyword=${keyword})}"
                           style="text-decoration: none; color: inherit;">
                            Tên Danh mục
                            <i th:if="${sortField == 'name'}" th:class="${sortDir == 'asc' ? 'fas fa-sort-up' : 'fas fa-sort-down'}"></i>
                        </a>
                    </th>
                    <th>Mô tả</th>
                    <th>Hành động</th>
                    
                    
                    <th class="text-center">Xem Shop</th> 
                </tr>
            </thead>
            <tbody>
                <tr th:each="category : ${listCategories}">
                    <td th:text="${category.id}">1</td>
                    <td th:text="${category.name}">Quần Áo Nữ</td>
                    <td th:text="${category.description}">Mô tả chi tiết về danh mục.</td>
                    <td>
                        <a th:href="@{/admin/category/edit/{id}(id=${category.id})}" class="btn btn-sm btn-info me-2">Sửa</a>
                        <a th:href="@{/admin/category/delete/{id}(id=${category.id})}" class="btn btn-sm btn-danger"
                           onclick="return confirm('Bạn có chắc chắn muốn xóa Danh mục này không?');">Xóa</a>
                    </td>
                    
                    
                    <td class="text-center">
                      
                        <a th:href="@{/shop(category=${category.id})}" 
                           target="_blank" 
                           class="btn btn-sm btn-success">
                            <i class="fas fa-eye"></i> Xem Sản phẩm
                        </a>
                    </td>
                </tr>
            </tbody>
        </table>

        <!-- phân trang -->
        <div th:if="${totalPages > 0}" class="row">
            <div class="col-sm-12 text-center">
                <nav>
                    <ul class="pagination justify-content-center">
                        <li th:class="${currentPage == 1 ? 'page-item disabled' : 'page-item'}">
                          
                            <a th:href="@{/admin/categories(pageNo=${currentPage - 1}, pageSize=${pageSize}, sortField=${sortField}, sortDir=${sortDir}, keyword=${keyword})}" 
                               class="page-link">Trước</a>
                        </li>
                        
                        <li th:each="i: ${#numbers.sequence(1, totalPages)}" 
                            th:class="${currentPage == i ? 'page-item active' : 'page-item'}">
                        
                            <a th:href="@{/admin/categories(pageNo=${i}, pageSize=${pageSize}, sortField=${sortField}, sortDir=${sortDir}, keyword=${keyword})}" 
                               class="page-link" th:text="${i}">1</a>
                        </li>

                        <li th:class="${currentPage == totalPages ? 'page-item disabled' : 'page-item'}">
                         
                            <a th:href="@{/admin/categories(pageNo=${currentPage + 1}, pageSize=${pageSize}, sortField=${sortField}, sortDir=${sortDir}, keyword=${keyword})}" 
                               class="page-link">Tiếp</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</body>
</html>
