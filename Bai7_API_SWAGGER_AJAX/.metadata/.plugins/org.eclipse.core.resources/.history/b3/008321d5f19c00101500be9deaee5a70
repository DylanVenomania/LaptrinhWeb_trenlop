<!DOCTYPE html>
<html lang="vi" xmlns:th="http://www.thymeleaf.org"
      xmlns:layout="http://www.ultraq.net.nz/thymeleaf/layout">
<head>
    <meta charset="UTF-8">
    <title layout:title-document="Little Lotus WebShop"></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"/>
    <style>
        .little-lotus-header 
        { 
            background-color: #f7f3f0; 
            padding: 15px 0;
        }
        .footer 
        {
            background-color: #e0e0e0;
            padding: 10px 0;
            text-align: center;
            font-size: 0.85em;
        }
    </style>
</head>
<body>

<header class="p-3 mb-3 border-bottom">
    <div class="container">
        <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start">
            <a th:href="@{/}" class="d-flex align-items-center mb-2 mb-lg-0 text-dark text-decoration-none me-3">
                <span class="fs-4">Little Lotus Shop</span>
            </a>
            
           
            <nav class="nav col-12 col-lg-auto me-lg-auto mb-2 justify-content-center mb-md-0">
                <!-- Nút trang chủ Shop  -->
                <a th:href="@{/shop}" class="btn btn-outline-primary me-2">🛍️ Trang Shop (Khách hàng)</a>
                
                <!-- Nút quản lý Category  -->
                <a th:href="@{/admin/categories}" class="btn btn-outline-secondary me-2">🛠️ Quản lý Danh mục</a>
                
                <!-- Nút quản lý Product  -->
                <a th:href="@{/admin/products}" class="btn btn-outline-secondary">📦 Quản lý Sản phẩm</a>
            </nav>
            
            <!-- Hình ảnh sinh viên  -->
            <div class="dropdown text-end">
                <img th:src="@{/images/avatar.jpg}" alt="Sinh viên" width="40" height="70" class="rounded-circle"> 
            </div>
            
        </div>
    </div>
</header>
    
    <main class="container my-4">
        <div layout:fragment="content">
            </div>
    </main>

    <footer class="footer mt-auto">
        <div class="container">
            <p>&copy; <span th:text="${#dates.year(#dates.createNow())}">2024</span> | Project Web Thời Trang Little Lotus | Sinh viên thực hiện: [Tôn Hoàng Cầm] - [23110186]</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>