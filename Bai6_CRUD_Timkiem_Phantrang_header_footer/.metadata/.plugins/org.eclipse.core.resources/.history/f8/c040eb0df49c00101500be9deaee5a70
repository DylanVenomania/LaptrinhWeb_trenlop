<!DOCTYPE html>
<html lang="vi" xmlns:th="http://www.thymeleaf.org"
      xmlns:layout="http://www.ultraq.net.nz/thymeleaf/layout">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" 
          rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" 
          crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    
    <title layout:title-default="Little Lotus Shop"></title>

    <style>
        :root {
            --color-rose-quartz: #FFC0CB; /* Hồng Pastel/Rose Quartz */
            --color-serenity: #A2E1FF; /* Xanh dương nhạt/Serenity */
            --color-grey-dark: #4A5568; /* Xám đậm cho Text */
            --color-background: #FFFFFF; /* Nền trắng tinh khiết */
            --border-radius: 0.75rem; /* Góc bo tròn lớn */
            --box-shadow-subtle: 0 4px 12px rgba(0, 0, 0, 0.05);
        }

        body {
            font-family: 'Poppins', 'Segoe UI', sans-serif;
            background-color: var(--color-background);
            color: var(--color-grey-dark);
        }

        /* Tiêu đề & Các thành phần chính */
        h2, .fs-4, th {
            font-weight: 600;
            color: var(--color-grey-dark);
        }

        /* Tùy chỉnh Header Admin */
        .header-admin {
            background-color: white; 
            box-shadow: var(--box-shadow-subtle);
            border-bottom: none !important;
        }

        /* Nút Chính (Primary - Rose Quartz) */
        .btn-primary {
            background-color: var(--color-rose-quartz);
            border-color: var(--color-rose-quartz);
            color: var(--color-grey-dark);
            border-radius: var(--border-radius);
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            background-color: #F8B4C0; /* Hồng đậm hơn */
            border-color: #F8B4C0;
            color: var(--color-grey-dark);
        }
        
        /* Nút Thứ Cấp (Secondary - Serenity) */
        .btn-outline-secondary {
            color: var(--color-serenity);
            border-color: var(--color-serenity);
            border-radius: var(--border-radius);
            transition: all 0.3s ease;
        }
        
        .btn-outline-secondary:hover {
            background-color: var(--color-serenity);
            color: white;
            border-color: var(--color-serenity);
        }
        
        /* Bảng biểu */
        .table {
            border-radius: var(--border-radius);
            overflow: hidden; 
            box-shadow: var(--box-shadow-subtle);
            background-color: white;
        }
        
        .table thead th {
            background-color: var(--color-serenity); /* Màu xanh nhạt cho header bảng */
            color: white;
            font-weight: 600;
        }
        
        /* Thẻ Alert/Message */
        .alert-success {
            background-color: #EBF8FF; /* Xanh nhạt */
            color: #4C51BF; /* Xanh tím than */
            border-color: #BEE3F8;
            border-radius: var(--border-radius);
        }
        
        /* Form và Input */
        .form-control, .btn, .alert {
            border-radius: var(--border-radius);
        }

        /* Hình ảnh Avatar */
        .rounded-circle {
            border: 3px solid var(--color-rose-quartz);
        }
        
    </style>
</head>
<body>
    
    <header class="p-3 mb-4 border-bottom header-admin">
        <div class="container">
            <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start">
                <a th:href="@{/}" class="d-flex align-items-center mb-2 mb-lg-0 text-dark text-decoration-none me-4">
                    <i class="fas fa-heart me-2" style="color: var(--color-rose-quartz); font-size: 1.5rem;"></i>
                    <span class="fs-4 fw-bold" style="color: var(--color-grey-dark);">Little Lotus Shop</span>
                </a>
                
                <nav class="nav col-12 col-lg-auto me-lg-auto mb-2 justify-content-center mb-md-0">
                    <a th:href="@{/shop}" class="btn btn-outline-secondary me-2">
                        <i class="fas fa-store"></i> Trang Shop
                    </a>
                    
                    <a th:href="@{/admin/categories}" class="btn btn-outline-secondary me-2">
                        <i class="fas fa-cubes"></i> Quản lý Danh mục
                    </a>
                    
                    <a th:href="@{/admin/products}" class="btn btn-outline-secondary">
                        <i class="fas fa-box-open"></i> Quản lý Sản phẩm
                    </a>
                </nav>
                
                <div class="dropdown text-end ms-auto">
                    <img th:src="@{/images/avatar.jpg}" alt="Sinh viên" width="40" height="40" class="rounded-circle shadow-sm"> 
                </div>
                
            </div>
        </div>
    </header>

    <main class="container">
        <div layout:fragment="content">
            </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" 
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" 
            crossorigin="anonymous"></script>
</body>
</html>