<!DOCTYPE html>
<html lang="vi" xmlns:th="http://www.thymeleaf.org"
      xmlns:layout="http://www.ultraq.net.nz/thymeleaf/layout"
      layout:decorate="~{layouts/layout}">
<head>
    <title th:text="${formTitle}">Thêm/Sửa Sản phẩm</title>
</head>
<body>
    <div layout:fragment="content">
        <h2 class="mb-4" th:text="${formTitle}">Thêm/Sửa Sản phẩm</h2>
        
        <div class="container col-md-6">
           
            <form action="#" th:action="@{/admin/product/save}" th:object="${product}" method="POST">
                
               
                <input type="hidden" th:field="*{id}">
                
                <div class="mb-3">
                    <label for="name" class="form-label">Tên Sản phẩm:</label>
                    <input type="text" th:field="*{name}" id="name" class="form-control" placeholder="Nhập tên sản phẩm" required>
                </div>
                
                <div class="mb-3">
                    <label for="price" class="form-label">Giá:</label>
                    
                    <input type="number" th:field="*{price}" id="price" class="form-control" placeholder="Nhập giá" required step="1000">
                </div>

                <div class="mb-3">
                    <label for="imageUrl" class="form-label">URL Hình ảnh:</label>
                    <input type="text" th:field="*{imageUrl}" id="imageUrl" class="form-control" placeholder="URL hình ảnh (tùy chọn)">
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">Mô tả Sản phẩm:</label>
                    <textarea th:field="*{description}" id="description" class="form-control" rows="4" placeholder="Nhập mô tả chi tiết"></textarea>
                </div>

                <div class="mb-3">
                    <label for="category" class="form-label">Danh mục:</label>
                    <select th:field="*{category}" id="category" class="form-control" required>
                        <option th:each="cat : ${categories}" 
                                th:value="${cat.id}" 
                                th:text="${cat.name}">Tên Danh mục</option>
                    </select>
                </div>
                
                <div class="text-center">
                    <button type="submit" class="btn btn-success me-2">Lưu Sản phẩm</button>
                  
                    <a th:href="@{/admin/products}" class="btn btn-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</body>
</html>
