<!DOCTYPE html>
<html lang="vi" xmlns:th="http://www.thymeleaf.org"
      xmlns:layout="http://www.ultraq.net.nz/thymeleaf/layout"
      layout:decorate="~{layouts/layout}">
<head>
    <title th:text="${formTitle}">Thêm/Sửa Sản phẩm</title>
</head>
<body>
    <div layout:fragment="content">
        <h2 class="mb-4" th:text="${formTitle}">Thêm/Sửa Sản phẩm</h2>
        
        <div class="container col-md-8 col-lg-6 p-4" style="background-color: var(--color-background-card); border-radius: var(--border-radius-large);">
            <form action="#" th:action="@{/admin/product/save}" th:object="${product}" method="POST">
                
                <input type="hidden" th:field="*{id}">
                
                <div class="mb-4">
                    <label for="name" class="form-label fw-bold">Tên Sản phẩm:</label>
                    <input type="text" th:field="*{name}" id="name" class="form-control" placeholder="Áo Thun Basic..." required>
                </div>
                
                <div class="mb-4">
                    <label for="price" class="form-label fw-bold">Giá:</label>
                    <input type="number" th:field="*{price}" id="price" class="form-control" placeholder="150000" required step="1000">
                </div>

                <div class="mb-4">
                    <label for="imageUrl" class="form-label fw-bold">URL Hình ảnh:</label>
                    <input type="text" th:field="*{imageUrl}" id="imageUrl" class="form-control" placeholder="http://example.com/image.jpg">
                </div>

                <div class="mb-4">
                    <label for="description" class="form-label fw-bold">Mô tả Sản phẩm:</label>
                    <textarea th:field="*{description}" id="description" class="form-control" rows="4" placeholder="Mô tả chi tiết sản phẩm..."></textarea>
                </div>

                <div class="mb-4">
                    <label for="category" class="form-label fw-bold">Danh mục:</label>
                    <select th:field="*{category}" id="category" class="form-select" required>
                        <option th:each="cat : ${categories}" 
                                th:value="${cat.id}" 
                                th:text="${cat.name}">Tên Danh mục</option>
                    </select>
                </div>
                
                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-primary me-3">
                        <i class="fas fa-save me-1"></i> Lưu Sản phẩm
                    </button>
                    <a th:href="@{/admin/products}" class="btn btn-outline-secondary">
                        <i class="fas fa-ban me-1"></i> Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</body>
</html>