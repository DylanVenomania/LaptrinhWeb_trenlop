<!DOCTYPE html>
<html lang="vi" xmlns:th="http://www.thymeleaf.org"
      xmlns:layout="http://www.ultraq.net.nz/thymeleaf/layout"
      layout:decorate="~{layouts/layout}">
<head>
    <title>Quản lý Sản phẩm</title>
</head>
<body>
    <div layout:fragment="content">
        <h2 class="mb-4">Quản lý Sản phẩm (CRUD & Phân trang)</h2>

        <div th:if="${message}" class="alert alert-success" role="alert" th:text="${message}"></div>
        <div th:if="${error}" class="alert alert-danger" role="alert" th:text="${error}"></div>
        
        <div class="d-flex justify-content-between mb-3">
            <a th:href="@{/admin/product/new}" class="btn btn-primary">Thêm Sản phẩm Mới</a>
            
            <form th:action="@{/admin/products}" method="get" class="d-flex">
                <input type="text" name="keyword" th:value="${keyword}" class="form-control me-2" placeholder="Tìm kiếm theo Tên..." required>
                <input type="hidden" name="pageSize" th:value="${pageSize}">
                <button type="submit" class="btn btn-outline-secondary">Tìm kiếm</button>
                <a th:href="@{/admin/products(pageSize=${pageSize})}" class="btn btn-outline-danger ms-2">Xóa Filter</a>
            </form>
        </div>

        <table class="table table-bordered table-striped">
            <thead class="table-light">
                <tr>
                    <th>
                        <a th:href="@{/admin/products(pageNo=${currentPage}, pageSize=${pageSize}, sortField='id', sortDir=${reverseSortDir}, keyword=${keyword})}"
                           style="text-decoration: none; color: inherit;">
                            ID
                            <i th:if="${sortField == 'id'}" th:class="${sortDir == 'asc' ? 'fas fa-sort-up' : 'fas fa-sort-down'}"></i>
                        </a>
                    </th>
                    <th>
                        <a th:href="@{/admin/products(pageNo=${currentPage}, pageSize=${pageSize}, sortField='name', sortDir=${reverseSortDir}, keyword=${keyword})}"
                           style="text-decoration: none; color: inherit;">
                            Tên Sản phẩm
                            <i th:if="${sortField == 'name'}" th:class="${sortDir == 'asc' ? 'fas fa-sort-up' : 'fas fa-sort-down'}"></i>
                        </a>
                    </th>
                    <th>Giá</th>
                    <th>Danh mục</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                <tr th:each="product : ${listProducts}">
                    <td th:text="${product.id}">1</td>
                    <td th:text="${product.name}">Áo Thun Oversize</td>
                    <td th:text="${#numbers.formatDecimal(product.price, 0, 'COMMA', 0, 'POINT')} + ' VNĐ'">150.000 VNĐ</td>
                    <td th:text="${product.category != null ? product.category.name : 'N/A'}">Quần Áo Nữ</td>
                    <td>
                        <a th:href="@{/admin/product/edit/{id}(id=${product.id})}" class="btn btn-sm btn-info me-2">Sửa</a>
                        <a th:href="@{/admin/product/delete/{id}(id=${product.id})}" class="btn btn-sm btn-danger"
                           onclick="return confirm('Bạn có chắc chắn muốn xóa Sản phẩm này không?');">Xóa</a>
                    </td>
                </tr>
            </tbody>
        </table>

        <div th:if="${totalPages > 0}" class="row">
            <div class="col-sm-12 text-center">
                <nav>
                    <ul class="pagination justify-content-center">
                        <li th:class="${currentPage == 1 ? 'page-item disabled' : 'page-item'}">
                            <a th:href="@{/admin/products(pageNo=${currentPage - 1}, pageSize=${pageSize}, sortField=${sortField}, sortDir=${sortDir}, keyword=${keyword})}" 
                               class="page-link">Trước</a>
                        </li>
                        
                        <li th:each="i: ${#numbers.sequence(1, totalPages)}" 
                            th:class="${currentPage == i ? 'page-item active' : 'page-item'}">
                            <a th:href="@{/admin/products(pageNo=${i}, pageSize=${pageSize}, sortField=${sortField}, sortDir=${sortDir}, keyword=${keyword})}" 
                               class="page-link" th:text="${i}">1</a>
                        </li>

                        <li th:class="${currentPage == totalPages ? 'page-item disabled' : 'page-item'}">
                            <a th:href="@{/admin/products(pageNo=${currentPage + 1}, pageSize=${pageSize}, sortField=${sortField}, sortDir=${sortDir}, keyword=${keyword})}" 
                               class="page-link">Tiếp</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</body>
</html>