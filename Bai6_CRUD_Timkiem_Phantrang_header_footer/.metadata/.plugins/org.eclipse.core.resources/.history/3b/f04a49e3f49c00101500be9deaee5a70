<!DOCTYPE html>
<html lang="vi" xmlns:th="http://www.thymeleaf.org"
      xmlns:layout="http://www.ultraq.net.nz/thymeleaf/layout"
      layout:decorate="~{layouts/layout}">
<head>
    <title th:text="${formTitle}"></title>
</head>
<body>
    <div layout:fragment="content">
        <h2 th:text="${formTitle}" class="mb-4">Form Danh mục</h2>
        
        <form th:action="@{/category/save}" th:object="${category}" method="post">
            <input type="hidden" th:field="*{id}" />

            <div class="mb-3">
                <label for="name" class="form-label">Tên Danh mục (*)</label>
                <input type="text" th:field="*{name}" id="name" class="form-control" required/>
                </div>
            
            <div class="mb-3">
                <label for="description" class="form-label">Mô tả</label>
                <textarea th:field="*{description}" id="description" class="form-control"></textarea>
            </div>
            
            <button type="submit" class="btn btn-success me-2">Lưu Danh mục</button>
            <a th:href="@{/categories}" class="btn btn-secondary">Quay lại Danh sách</a>
        </form>
    </div>
</body>
</html>