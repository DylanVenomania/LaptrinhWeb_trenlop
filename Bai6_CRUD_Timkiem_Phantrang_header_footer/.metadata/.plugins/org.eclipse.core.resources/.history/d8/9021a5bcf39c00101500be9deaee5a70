<!DOCTYPE html>
<html lang="vi" xmlns:th="http://www.thymeleaf.org"
      xmlns:layout="http://www.ultraq.net.nz/thymeleaf/layout">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" 
          rel="stylesheet" xintegrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" 
          crossorigin="anonymous">
  
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    
    <title layout:title-default="Little Lotus Shop"></title>

   
    <style>
        :root {
            --color-primary: #A7F3D0; 
            --color-secondary: #059669; 
            --color-background: #F0FFF0;
            --color-text: #2D3748;
            --border-radius: 0.75rem; 
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--color-background);
            color: var(--color-text);
        }

       
        .header-admin {
            background-color: white; 
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            border-bottom: none !important;
        }

        
        .btn-primary, .btn-outline-primary {
            border-radius: var(--border-radius);
            font-weight: 500;
        }

        .btn-primary {
            background-color: var(--color-primary);
            border-color: var(--color-primary);
            color: var(--color-secondary);
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            background-color: var(--color-secondary);
            border-color: var(--color-secondary);
            color: white;
        }
        
        .btn-outline-secondary {
            color: var(--color-secondary);
            border-color: var(--color-secondary);
            background-color: transparent;
        }
        
        .btn-outline-secondary:hover {
            background-color: var(--color-secondary);
            color: white;
            border-color: var(--color-secondary);
        }
        
       
        .table {
            border-radius: var(--border-radius);
            overflow: hidden;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            background-color: white;
        }
        .table-light, .table-striped > tbody > tr:nth-of-type(odd) {
            background-color: #F8FFF8; 
        }
        .table thead th {
            background-color: var(--color-primary);
            color: var(--color-secondary);
            font-weight: 600;
        }
        
     
        .alert-success {
            background-color: #E6FFFA;
            color: #38A169; 
            border-color: #9AE6B4;
            border-radius: var(--border-radius);
        }

        /* Hình ảnh Avatar */
        .rounded-circle {
            border: 3px solid var(--color-primary);
        }
        
    </style>
</head>
<body>
    
    <!-- ADMIN HEADER/NAVBAR -->
    <header class="p-3 mb-4 border-bottom header-admin">
        <div class="container">
            <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-lg-start">
                <a th:href="@{/}" class="d-flex align-items-center mb-2 mb-lg-0 text-dark text-decoration-none me-4">
                    <i class="fas fa-seedling me-2 text-success" style="font-size: 1.5rem;"></i>
                    <span class="fs-4 fw-bold" style="color: var(--color-secondary);">Little Lotus Shop</span>
                </a>
                
                <nav class="nav col-12 col-lg-auto me-lg-auto mb-2 justify-content-center mb-md-0">
                    <!-- trang Shop -->
                    <a th:href="@{/shop}" class="btn btn-outline-secondary me-2">
                        <i class="fas fa-store"></i> Trang Shop
                    </a>
                    
                    <!--  quản lý danh mục -->
                    <a th:href="@{/admin/categories}" class="btn btn-outline-secondary me-2">
                        <i class="fas fa-list-alt"></i> Quản lý Danh mục
                    </a>
                    
                    <!-- quản lý Sản phẩm -->
                    <a th:href="@{/admin/products}" class="btn btn-outline-secondary">
                        <i class="fas fa-box"></i> Quản lý Sản phẩm
                    </a>
                </nav>
                
                <!-- Hình ảnh -->
                <div class="dropdown text-end ms-auto">
      
                    <img th:src="@{/images/avatar.jpg}" alt="Sinh viên" width="40" height="40" class="rounded-circle shadow-sm"> 
                </div>
                
            </div>
        </div>
    </header>

    <!-- khu vuc chinh -->
    <main class="container">
        <div layout:fragment="content">
            <!-- nội dung cụ thể từng trang -->
        </div>
    </main>

    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" 
            xintegrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" 
            crossorigin="anonymous"></script>
</body>
</html>
